# Copy to .env.local and fill in. Never put real keys in this file: it is committed.

# Supabase project settings: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Optional: emailing invoices (Resend, https://resend.com). Leave empty to turn email off;
# the rest of the app works without it. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Your Business <invoices@yourdomain.com>"
